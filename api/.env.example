APP_NAME=FuelKenya API
APP_VERSION=0.1.0
API_PREFIX=/api/v1
DOCS_URL=/docs
REDOC_URL=/redoc
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fuelkenya
INGEST_TOKEN=
# Set the same value as FUELKENYA_API_TOKEN on the web app so server-rendered
# pages skip the per-IP rate limit. Leave empty to trust no client.
TRUSTED_CLIENT_TOKEN=
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
SQL_ECHO=true
